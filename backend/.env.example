DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000
FRONTEND_URL="http://localhost:3000"

# Account matching this address receives the administrator role on registration or login.
ADMIN_EMAIL="admin@example.com"

# Optional visual AI comparison. Keep false to use local perceptual matching only.
AI_IMAGE_MATCH_ENABLED=false
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-4.1-mini"

# Optional SMTP settings for match and claim emails.
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM=""
